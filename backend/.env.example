# =============================================================================
# Employee Portal (HRMS) — backend environment
# =============================================================================
#
# Variable NAMES only. Never commit a value from here.
#
# Copy to `.env` and fill in. `.env` is gitignored; `.env.example` is not, and
# is the file that tells the next person what a deployment needs.
#
# -----------------------------------------------------------------------------
# READ THIS FIRST — THREE VALUES MUST MATCH THE CUSTOMER PORTAL EXACTLY
# -----------------------------------------------------------------------------
#
#   MONGODB_URI                 same database, by design
#   JWT_SECRET                  a token minted by either portal must verify in
#                               the other, or an employee is signed out the
#                               moment they cross between them
#   HRMS_LOCAL_ENCRYPTION_KEY   see the encryption section below — getting this
#   HRMS_BLIND_INDEX_KEY        wrong makes existing employee PII unreadable
#
# Everything else may legitimately differ per deployment.
# =============================================================================


# ── Runtime ──────────────────────────────────────────────────────────────────
# 5001 in development so this can run alongside the Customer Portal's 5000.
PORT=
NODE_ENV=

# The Employee Portal SPA's origin. Used for CORS and for the links in emails
# (offer letters, helpdesk notifications) that people click back into.
# Development: http://localhost:5174
FRONTEND_URL=

# Absolute base URL used when a mail template has to build a link and no
# request is in hand. Falls back to FRONTEND_URL semantics; set both.
APP_BASE_URL=


# ── Database — SHARED WITH THE CUSTOMER PORTAL ───────────────────────────────
#
# The SAME connection string. Not a copy of the data, not a replica: the same
# `users`, `roles`, `employees`, `auditlogs` and every HRMS collection.
#
# This portal never seeds and never migrates. `seedDefaultRoles`,
# `seedInventoryDefaults` and `seedAlertRules` stay with the Customer Portal so
# there is exactly one writer for that data. See the note in server.js.
MONGODB_URI=


# ── Authentication — SHARED WITH THE CUSTOMER PORTAL ─────────────────────────
#
# JWT_SECRET must be byte-identical to the Customer Portal's. Both portals mint
# and verify tokens for the same accounts; a different secret does not create a
# second login, it creates a session that one portal cannot read.
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_ACCESS_EXPIRES_IN=

# Refresh tokens. JWT_REFRESH_SECRET falls back to JWT_SECRET when unset — if
# you set it here, set the same value there.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# bcrypt work factor. Leave unset unless you have measured a reason to change
# it; a value below the Customer Portal's would weaken hashes written here for
# accounts both portals share.
BCRYPT_ROUNDS=


# ── Email ────────────────────────────────────────────────────────────────────
#
# HRMS sends offer letters, helpdesk updates, leave and expense decisions.
# Without SMTP_HOST the mailer logs instead of sending, which is the correct
# development default.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Master switch for HRMS mail specifically. Unset = enabled.
HRMS_MAIL_ENABLED=

# Comma-separated addresses that must never receive mail, whatever a record
# says. Read by utils/mailRecipients.js.
BLOCKED_EMAILS=

# Read by utils/mailRecipients.js, which is shared verbatim with the Customer
# Portal. Only BLOCKED_EMAILS above affects HRMS mail; these three are consumed
# by booking templates that do not exist in this repository, and are listed for
# completeness rather than because HRMS needs them.
ALWAYS_CC_EMAILS=
BOOKING_CC_EMAILS=
SUPPORT_TEAM_EMAILS=


# ── Encryption of employee PII — GET THIS WRONG AND DATA READS AS GARBAGE ────
#
# Employee PAN, Aadhaar and bank details are encrypted at rest and searched
# through a blind index. Both are keyed, and BOTH KEYS MUST MATCH WHATEVER THE
# EXISTING DATA WAS WRITTEN WITH.
#
# At the time of the split the Customer Portal's .env set NEITHER, so existing
# rows were encrypted with the compiled-in development defaults:
#
#   HRMS_LOCAL_ENCRYPTION_KEY  ->  'shraddha-hrms-local-development-key'
#   HRMS_BLIND_INDEX_KEY       ->  'development-blind-index-key-not-for-production'
#
# So: in development, leaving both unset here reproduces exactly what the data
# was written with, and everything decrypts. Setting one to a NEW value does
# not fail loudly — it silently produces unreadable ciphertext and blind
# indexes that never match, so a duplicate-PAN check would stop working.
#
# To rotate them properly, use `npm run hrms:migrate-keys`, which re-encrypts
# existing rows. Never rotate by editing this file alone.
#
# NODE_ENV=production REFUSES to start without HRMS_BLIND_INDEX_KEY, which is
# the intended behaviour: a production blind index computed from a development
# key would make uniqueness checks meaningless.
HRMS_CRYPTO_DRIVER=
HRMS_LOCAL_ENCRYPTION_KEY=
HRMS_BLIND_INDEX_KEY=

# KMS driver (HRMS_CRYPTO_DRIVER=kms). Data-key cache lifetime in ms.
HRMS_KMS_KEY_ID=
HRMS_DEK_TTL_MS=


# ── File storage ─────────────────────────────────────────────────────────────
#
# `local` writes under STORAGE_LOCAL_PATH; `s3` requires the AWS block below.
# Defaults to `s3` when NODE_ENV=production and `local` otherwise, and the local
# driver REFUSES to run in production unless STORAGE_DRIVER is explicitly local.
#
# On S3 nothing needs doing: both portals addressed the same bucket and the same
# keys, so every existing document, payslip, résumé and selfie is already
# reachable from here.
#
# On local disk the files live in the tree they were written into. This repo
# ships a copy of the Customer Portal's backend/uploads/hrms, so a development
# machine works out of the box; point STORAGE_LOCAL_PATH at the original
# directory if you would rather have one store than two.
STORAGE_DRIVER=
STORAGE_LOCAL_PATH=

AWS_REGION=
AWS_S3_BUCKET=
# SSE-KMS is required — the S3 driver refuses to fall back to SSE-S3.
HRMS_S3_KMS_KEY_ID=


# ── Attendance ───────────────────────────────────────────────────────────────
# IANA zone the attendance day is computed in. Defaults to Asia/Kolkata.
HRMS_ATTENDANCE_TIME_ZONE=

# Biometric punch-clock webhook. The device has no session and authenticates
# with an HMAC-SHA256 signature over the raw request body. WITHOUT THIS SECRET
# THE WEBHOOK REFUSES EVERY REQUEST — which is the safe default, not a bug.
# Must match the value configured on the device.
HRMS_BIOMETRIC_WEBHOOK_SECRET=
HRMS_BIOMETRIC_RATE_LIMIT=

# Reverse-geocoding for punch locations (OpenStreetMap Nominatim).
HRMS_GEOCODER_USER_AGENT=
HRMS_GEOCODER_TIMEOUT_MS=


# ── Public careers site ──────────────────────────────────────────────────────
# Requests/window for the unauthenticated careers endpoints.
HRMS_CAREERS_BROWSE_RATE_LIMIT=
HRMS_CAREERS_WRITE_RATE_LIMIT=


# ── Employee import ──────────────────────────────────────────────────────────
# Ceiling on rows accepted by one import run.
HRMS_IMPORT_MAX_RECORDS=


# ── Retention sweep — READ BEFORE ENABLING ───────────────────────────────────
#
# This job DELETES: audit rows, attendance selfies, employee documents and
# inbox items past their configured window. Both portals point at the same
# database, and the Customer Portal still schedules it on its own daily cron.
#
# Running it in both places is the duplicate-execution hazard the separation has
# to answer for, so it is OFF unless this deployment says otherwise. Order:
#
#   1. deploy with HRMS_RETENTION_CRON unset (or anything but "enabled")
#   2. remove the runHrmsRetentionSweep call from the Customer Portal's cron
#   3. only then set HRMS_RETENTION_CRON=enabled here
#
# Only the exact string "enabled" turns it on.
HRMS_RETENTION_CRON=
# Cron expression. Defaults to '0 0 * * *' (daily at midnight), matching the
# schedule it ran on in the Customer Portal.
HRMS_RETENTION_CRON_SCHEDULE=
HRMS_RETENTION_BATCH_SIZE=
